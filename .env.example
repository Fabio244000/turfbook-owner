# Local development only (docker-compose). AWS Lambda never reads .env: its values come
# from SSM / Secrets Manager at deploy time (see serverless.yml and deploy/env/).

# Admin of the local Postgres container (only used to initialize it).
POSTGRES_USER=...
POSTGRES_PASSWORD=...
POSTGRES_DB=...

# Service database and user, created on the first start by scripts/database/ (same as AWS).
SERVICE_DB_NAME=turfbook_owner_dev
SERVICE_DB_USER=owner_dev_db_user
SERVICE_DB_PASSWORD=...

# The app connects with the service user, never with the admin.
DATABASE_URL=postgresql+psycopg://owner_dev_db_user:<pass>@db:5432/turfbook_owner_dev

# Public key of identity's session token (RS256). Locally, the public half of the pair
# identity uses (openssl pkey -in private.pem -pubout), in double quotes, over several lines.
JWT_PUBLIC_KEY="several lines"

# Optional: they have a default in Settings. Uncomment only to use another value.
# API_PREFIX=/api
# JWT_ALGORITHM=RS256
# JWT_ISSUER=turfbook-identity
